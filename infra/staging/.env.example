# Copy to .env on the staging host. Never commit the populated file.
STAGING_APP_URL=https://app.staging.example.invalid
STAGING_ADMIN_URL=https://admin.staging.example.invalid
STAGING_API_URL=https://api.staging.example.invalid
STAGING_DATABASE_PASSWORD=replace-with-32-plus-random-characters
AUTH_TOKEN_PEPPER=replace-with-64-plus-random-characters
BETA_INVITE_CODE=replace-with-a-random-private-invite
BETA_ALLOWED_EMAILS=owner@example.invalid
SUPPORT_EMAIL=support@example.invalid
ADMIN_PREVIEW_MODE=false

# Enable only after Google billing, restrictions and privacy review are complete.
GOOGLE_MAPS_MODE=mock
GOOGLE_MAPS_API_KEY=
