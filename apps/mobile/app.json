{
  "expo": {
    "name": "ValX",
    "slug": "valx",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "valx",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0E0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.valx.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "uk.co.valx.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF8A1F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
