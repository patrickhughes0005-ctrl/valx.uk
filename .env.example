# Copy the relevant values into app-specific .env files. Never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgresql://valx:valx_local_only@localhost:5432/valx
API_HOST=127.0.0.1
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Private-beta identity. Production requires a 32+ character token pepper and
# at least one invitation mechanism.
AUTH_TOKEN_PEPPER=valx-local-pepper-change-me
SESSION_TTL_HOURS=168
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
BETA_REGISTRATION_MODE=invite_only
BETA_INVITE_CODE=replace-with-a-random-private-invite
BETA_ALLOWED_EMAILS=
SUPPORT_EMAIL=support@example.invalid
PUBLIC_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001

# Local development captures auth emails in memory. Production refuses to
# start unless SMTP is configured. Use an app-specific mailbox password.
AUTH_EMAIL_MODE=capture
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ValX <support@valx.uk>

# DVLA registration is currently closed, so mock is the safe default.
DVLA_MODE=mock
DVLA_API_BASE_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1
DVLA_API_KEY=

# Google integrations also support mock mode for local development and CI.
GOOGLE_MAPS_MODE=mock
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com/directions/v2

# Client-safe URLs only. Do not place server secrets in NEXT_PUBLIC_ or EXPO_PUBLIC_ keys.
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
ADMIN_PREVIEW_MODE=true
ADMIN_PREVIEW_EMAIL=admin@valx.local
